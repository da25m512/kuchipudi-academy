# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Cloud -> Manage app -> Settings -> Secrets.

# The admin console password. Lives only here, never in the repository.
admin_password = "pick-something-long-and-private"

[github]
token  = "github_pat_xxxxxxxxxxxxxxxxxxxxxxxx"   # fine-grained PAT, Contents: Read & write
owner  = "your-github-username"
repo   = "kuchipudi-academy"
branch = "content"                               # data branch, created automatically
