# Copy to .streamlit/secrets.toml locally, or paste into
# Streamlit Cloud -> App settings -> Secrets.

[github]
token  = "github_pat_xxxxxxxxxxxxxxxxxxxxxxxx"   # fine-grained PAT with Contents: Read & write on this repo
repo   = "your-username/kuchipudi-academy"
branch = "main"

[admin]
# Optional break-glass login: username "admin" + this password always works.
password = "change-me-to-something-long"
